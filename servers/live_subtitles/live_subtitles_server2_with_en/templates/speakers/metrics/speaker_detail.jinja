<!-- Jet_Windows_Workspace/servers/live_subtitles/live_subtitles_server2_with_en/templates/speakers/metrics/speaker_detail.jinja -->
{% extends "base.jinja" %}
{% block title %}Speaker {{ speaker.speaker_label }} - Details{% endblock %}
{% block extra_head %}
  <style>
    /* Segment ID should use available space with ellipsis on overflow */
    .segment-id-cell {
        max-width: 220px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-family: 'SF Mono', 'Fira Code', 'Consolas', monospace;
        font-size: 12px;
        color: var(--text-secondary);
    }
    
    .actions-cell {
        white-space: nowrap;
        display: flex;
        gap: 8px;
        align-items: center;
    }
    
    .actions-cell a {
        font-size: 12px;
        padding: 4px 10px;
        border-radius: 4px;
        background: var(--bg-tertiary);
        color: var(--accent-blue);
        text-decoration: none;
        transition: background 0.15s;
    }
    
    .actions-cell a:hover {
        background: rgba(88,166,255,0.15);
        text-decoration: none;
    }
    
    /* Timestamp column - fixed width for alignment */
    .timestamp-cell {
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
        font-family: 'SF Mono', 'Fira Code', 'Consolas', monospace;
        font-size: 13px;
    }
    
    .duration-cell {
        font-variant-numeric: tabular-nums;
        font-family: 'SF Mono', 'Fira Code', 'Consolas', monospace;
        font-size: 13px;
        text-align: right;
    }
    
    .confidence-cell {
        font-variant-numeric: tabular-nums;
        font-weight: 600;
        text-align: center;
    }
  </style>
{% endblock %}
{% block content %}
  <div class="page-header">
    <h1>🔍 Speaker: {{ speaker.speaker_label }}</h1>
    <p>Detailed cohesion and activity metrics</p>
  </div>
  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-value blue">{{ speaker.segment_count }}</div>
      <div class="stat-label">Segments</div>
    </div>
    <div class="stat-card">
      <div class="stat-value purple">{{ speaker.embedding_count }}</div>
      <div class="stat-label">Embeddings</div>
    </div>
    <div class="stat-card">
      <div class="stat-value {% if speaker.cohesion_score and speaker.cohesion_score >= 0.7 %}green {% elif speaker.cohesion_score and speaker.cohesion_score >= 0.5 %}yellow {% else %}red{% endif %}">
        {{ "%.3f"|format(speaker.cohesion_score or 0) }}
      </div>
      <div class="stat-label">Cohesion Score</div>
    </div>
    <div class="stat-card">
      <div class="stat-value blue">{{ "%.1f"|format(speaker.active_duration or 0) }}s</div>
      <div class="stat-label">Active Duration</div>
    </div>
  </div>
  <div class="two-col">
    <!-- Pairwise Similarity Stats -->
    <div class="card">
      <div class="card-header">📐 Pairwise Similarity Statistics</div>
      <table>
        <tr>
          <td>Mean Pairwise Similarity</td>
          <td><strong>{{ "%.4f"|format(speaker.mean_pairwise_similarity) if speaker.mean_pairwise_similarity else 'N/A' }}</strong></td>
        </tr>
        <tr>
          <td>Std Pairwise Similarity</td>
          <td>{{ "%.4f"|format(speaker.std_pairwise_similarity) if speaker.std_pairwise_similarity else 'N/A' }}</td>
        </tr>
        <tr>
          <td>Min Pairwise Similarity</td>
          <td>{{ "%.4f"|format(speaker.min_pairwise_similarity) if speaker.min_pairwise_similarity else 'N/A' }}</td>
        </tr>
      </table>
    </div>
    <!-- Centroid Stats -->
    <div class="card">
      <div class="card-header">🎯 Centroid Statistics</div>
      <table>
        <tr>
          <td>Mean Similarity to Centroid</td>
          <td><strong>{{ "%.4f"|format(speaker.centroid_similarity_mean) if speaker.centroid_similarity_mean else 'N/A' }}</strong></td>
        </tr>
        <tr>
          <td>Std Similarity to Centroid</td>
          <td>{{ "%.4f"|format(speaker.centroid_similarity_std) if speaker.centroid_similarity_std else 'N/A' }}</td>
        </tr>
        <tr>
          <td>Min Similarity to Centroid</td>
          <td>{{ "%.4f"|format(speaker.min_similarity_to_centroid) if speaker.min_similarity_to_centroid else 'N/A' }}</td>
        </tr>
        <tr>
          <td>Max Similarity to Centroid</td>
          <td>{{ "%.4f"|format(speaker.max_similarity_to_centroid) if speaker.max_similarity_to_centroid else 'N/A' }}</td>
        </tr>
        <tr>
          <td>Centroid Quality</td>
          <td>{{ "%.2f"|format(speaker.centroid_quality or 0) }}</td>
        </tr>
      </table>
    </div>
  </div>
  <!-- Timeline -->
  <div class="card">
    <div class="card-header">⏱️ Activity Timeline</div>
    <table>
      <tr>
        <td style="width: 140px;">First Seen</td>
        <td>{{ "%.2f"|format(speaker.first_seen or 0) }}s</td>
      </tr>
      <tr>
        <td>Last Seen</td>
        <td>{{ "%.2f"|format(speaker.last_seen or 0) }}s</td>
      </tr>
      <tr>
        <td>Active Duration</td>
        <td>{{ "%.2f"|format(speaker.active_duration or 0) }}s</td>
      </tr>
      <tr>
        <td>Status</td>
        <td><span class="badge {% if speaker.status == 'healthy' %}badge-green{% elif speaker.status == 'warning' %}badge-yellow{% else %}badge-red{% endif %}">{{ speaker.status }}</span></td>
      </tr>
    </table>
  </div>
  <!-- Associated Segments -->
  <div class="card">
    <div class="card-header">📋 Segments ({{ segments.total }})</div>
    {% if segments.segments %}
      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th style="width: 50px;">#</th>
              <th>Segment ID</th>
              <th style="width: 100px;">Timestamp</th>
              <th style="width: 90px;">Duration</th>
              <th style="width: 100px;">Confidence</th>
              <th style="width: 160px;">Match Type</th>
              <th style="width: 160px;">Actions</th>
            </tr>
          </thead>
          <tbody>
            {% for seg in segments.segments %}
              <tr>
                <td>{{ seg.index }}</td>
                <td>
                  <div class="segment-id-cell" title="{{ seg.segment_id }}">{{ seg.segment_id }}</div>
                </td>
                <td class="timestamp-cell">{{ "%.2f"|format(seg.timestamp) }}s</td>
                <td class="duration-cell">{{ "%.2f"|format(seg.audio_duration) }}s</td>
                <td class="confidence-cell">
                  <span style="color: {% if seg.primary_confidence >= 0.8 %}var(--accent-green) {% elif seg.primary_confidence >= 0.6 %}var(--accent-yellow) {% else %}var(--accent-red){% endif %}">
                    {{ "%.3f"|format(seg.primary_confidence) }}
                  </span>
                </td>
                <td><span class="badge badge-blue">{{ seg.match_type }}</span></td>
                <td>
                  <div class="actions-cell">
                    <a href="/speakers/metrics/segments/{{ seg.index }}"
                       title="View segment details">📋 Details</a>
                    <a href="/speakers/metrics/api/segments/{{ seg.index }}"
                       title="View JSON data">JSON</a>
                  </div>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% else %}
      <p style="color: var(--text-secondary);">No segments found for this speaker.</p>
    {% endif %}
    <!-- Pagination info if needed -->
    {% if segments.total > segments.limit %}
      <div style="margin-top: 12px;
                  color: var(--text-secondary);
                  font-size: 13px">
        Showing {{ segments.segments|length }} of {{ segments.total }} segments
        (offset: {{ segments.offset }}, limit: {{ segments.limit }})
      </div>
    {% endif %}
  </div>
  <div style="margin-top: 16px;">
    <a href="/speakers/metrics/speakers">← Back to Speaker List</a>
    <span style="color: var(--text-muted); margin: 0 8px;">|</span>
    <a href="/speakers/metrics/api/speakers/{{ speaker.speaker_label }}">View JSON →</a>
  </div>
{% endblock %}
